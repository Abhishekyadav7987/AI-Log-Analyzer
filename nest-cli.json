{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "projects": {
    "api-gateway": { "type": "application", "root": "apps/api-gateway", "entryFile": "main", "sourceRoot": "apps/api-gateway/src", "compilerOptions": { "tsConfigPath": "apps/api-gateway/tsconfig.app.json" } },
    "log-service": { "type": "application", "root": "apps/log-service", "entryFile": "main", "sourceRoot": "apps/log-service/src", "compilerOptions": { "tsConfigPath": "apps/log-service/tsconfig.app.json" } },
    "anomaly-service": { "type": "application", "root": "apps/anomaly-service", "entryFile": "main", "sourceRoot": "apps/anomaly-service/src", "compilerOptions": { "tsConfigPath": "apps/anomaly-service/tsconfig.app.json" } },
    "ticket-service": { "type": "application", "root": "apps/ticket-service", "entryFile": "main", "sourceRoot": "apps/ticket-service/src", "compilerOptions": { "tsConfigPath": "apps/ticket-service/tsconfig.app.json" } },
    "ai-service": { "type": "application", "root": "apps/ai-service", "entryFile": "main", "sourceRoot": "apps/ai-service/src", "compilerOptions": { "tsConfigPath": "apps/ai-service/tsconfig.app.json" } },
    "action-service": { "type": "application", "root": "apps/action-service", "entryFile": "main", "sourceRoot": "apps/action-service/src", "compilerOptions": { "tsConfigPath": "apps/action-service/tsconfig.app.json" } },
    "websocket-gateway": { "type": "application", "root": "apps/websocket-gateway", "entryFile": "main", "sourceRoot": "apps/websocket-gateway/src", "compilerOptions": { "tsConfigPath": "apps/websocket-gateway/tsconfig.app.json" } },
    "common": { "type": "library", "root": "libs/common", "entryFile": "index", "sourceRoot": "libs/common/src", "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" } },
    "kafka": { "type": "library", "root": "libs/kafka", "entryFile": "index", "sourceRoot": "libs/kafka/src", "compilerOptions": { "tsConfigPath": "libs/kafka/tsconfig.lib.json" } },
    "database": { "type": "library", "root": "libs/database", "entryFile": "index", "sourceRoot": "libs/database/src", "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" } },
    "auth": { "type": "library", "root": "libs/auth", "entryFile": "index", "sourceRoot": "libs/auth/src", "compilerOptions": { "tsConfigPath": "libs/auth/tsconfig.lib.json" } }
  }
